    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', justifyContent: 'center', gap: 26 }}>
      <Box>
        <Text style={{ fontSize: 20, fontWeight: 'bold', color: '#185FA5' }}>IR 承载全部优化</Text>
