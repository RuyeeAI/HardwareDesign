  </Box>
  <Box style={{ height: 520, marginTop: 20, flexDirection: 'row', gap: 44 }}>
    <Box style={{ width: 660, alignItems: 'center', justifyContent: 'center' }}>
      <svg width={640} height={480} viewBox='0 0 640 480'>
        <rect x='40' y='20' width='220' height='60' fill='#FFFFFF' stroke='#1F2429' strokeWidth='2' />
        <text x='150' y='46' fontFamily='JetBrains Mono' fontSize='15' fill='#1F2429' text-anchor='middle'>P4-16 FRONTEND</text>
        <text x='150' y='66' fontSize='12' fill='#6B7280' text-anchor='middle'>Lexer · Parser · Directive</text>
