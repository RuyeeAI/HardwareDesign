        <line x1='150' y1='170' x2='150' y2='200' stroke='#1F2429' strokeWidth='2' />
        <rect x='40' y='200' width='220' height='60' fill='#FFFFFF' stroke='#1F2429' strokeWidth='2' />
        <text x='150' y='226' fontFamily='JetBrains Mono' fontSize='15' fill='#1F2429' text-anchor='middle'>OPT + SCHEDULER</text>
        <text x='150' y='246' fontSize='12' fill='#6B7280' text-anchor='middle'>constFold · CSE · DCE · 切拍</text>
        <line x1='150' y1='260' x2='150' y2='290' stroke='#1F2429' strokeWidth='2' />
        <rect x='40' y='290' width='220' height='60' fill='#FFFFFF' stroke='#1F2429' strokeWidth='2' />
        <text x='150' y='316' fontFamily='JetBrains Mono' fontSize='15' fill='#1F2429' text-anchor='middle'>CHISEL BACKEND</text>
        <text x='150' y='336' fontSize='12' fill='#6B7280' text-anchor='middle'>Emitter / StagedEmitter</text>
        <line x1='150' y1='350' x2='150' y2='380' stroke='#1F2429' strokeWidth='2' />
        <rect x='40' y='380' width='220' height='60' fill='none' stroke='#D9D9D2' strokeWidth='2' strokeDasharray='6 4' />
